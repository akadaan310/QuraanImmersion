{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ingest.js": { "memory": 1024, "maxDuration": 30 },
    "api/health.js": { "memory": 256, "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
